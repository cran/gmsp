{
  "schema": 1,
  "tableSchemas": {
    "record": {
      "character": ["ProcessID", "RecordID", "OwnerID", "EventID", "StationID", "FileID", "NetworkID", "Units"]
    },
    "signal": {
      "character": ["OCID", "ID"],
      "numeric": ["t", "s"]
    },
    "signalWide": {
      "numeric": ["t", "ts"],
      "numericPattern": "^(AT|VT|DT)\\."
    },
    "intensity": {
      "character": ["OCID", "ID", "IM", "units"],
      "numeric": "value"
    },
    "spectra": {
      "character": ["OCID", "ID"],
      "numeric": ["Tn", "S", "xi"]
    },
    "spectraWide": {
      "numeric": ["Tn", "xi"],
      "numericPattern": "^(PSA|PSV|SD)\\."
    },
    "modalWide": {
      "character": "OCID",
      "numeric": ["t", "signal", "residue"],
      "numericPattern": "^IMF[0-9]+$"
    },
    "target": {
      "numeric": ["Tn", "Sa", "Sa.low", "Sa.mean", "Sa.high"]
    },
    "suite": {
      "character": "kind",
      "numeric": ["Tn", "Sa"]
    },
    "scale": {
      "numeric": "scaleFactor"
    },
    "provider": {
      "character": ["OCID", "ID", "DIR", "Units"],
      "numeric": ["t", "s", "ts", "theta", "dip", "dt"]
    },
    "distances": {
      "numeric": ["EventLatitude", "EventLongitude", "EventDepth", "StationLatitude", "StationLongitude", "StationElevation", "Repi", "Rhyp"]
    },
    "site": {
      "numeric": "StationVs30"
    },
    "decomposition": {
      "character": ["OCID", "ID"],
      "numeric": ["t", "s", "frequency", "energy", "energyFraction"],
      "integer": ["mode", "boundary"]
    }
  },
